---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { getNews, formatDate } from '../../lib/news';

export async function getStaticPaths() {
  const posts = await getNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---

<Layout title={post.data.title} description={post.data.summary}>

  <!-- Hero -->
  <div class="relative pt-44 pb-20 overflow-hidden"
    style="background: url('/Bakgrunner/brea.JPG') center 30% / cover no-repeat;">
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(13,17,24,0.38) 0%, rgba(13,17,24,0.72) 100%);"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 sm:px-10">
      <div class="rounded-sm px-8 py-8 -mx-8"
        style="backdrop-filter: blur(14px); background: rgba(13,17,24,0.28);">
        <a href={`${base}news`}
          class="inline-block font-mono text-2xs tracking-caps uppercase text-white/50 mb-5
                 hover:text-white transition-colors duration-200
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white rounded-sm">← All news</a>
        <p class="font-mono text-2xs tracking-caps uppercase text-amber-light mb-4">{formatDate(post.data.date)}</p>
        <h1 class="font-display font-semibold text-white leading-display"
          style="font-size: clamp(2.25rem, 4.5vw, 4rem);">{post.data.title}</h1>
      </div>
    </div>
  </div>

  <!-- Body -->
  <div class="bg-cream">
    <div class="mx-auto max-w-4xl px-6 sm:px-10 py-16 sm:py-24 flex flex-col sm:flex-row gap-12">
      {post.data.image && (
        <div class="sm:w-56 shrink-0 flex justify-center sm:block">
          <img src={post.data.image} alt={post.data.imageAlt ?? ''}
            class="w-40 sm:w-full h-auto sm:sticky sm:top-28"
            style="filter: drop-shadow(0 32px 48px rgba(0,0,0,0.22)) drop-shadow(0 8px 16px rgba(0,0,0,0.10));" />
        </div>
      )}
      <article class="news-body flex-1 text-base text-body leading-body">
        <p class="text-lg text-charcoal leading-body mb-8">{post.data.summary}</p>
        <Content />
      </article>
    </div>
  </div>

</Layout>

<style>
  .news-body :global(p)      { margin-bottom: 1.25rem; }
  .news-body :global(h2)     { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 600; font-size: 1.875rem; line-height: 1.1; color: #14121a; margin: 2.5rem 0 1rem; }
  .news-body :global(ul)     { list-style: disc; padding-left: 1.25rem; margin-bottom: 1.25rem; }
  .news-body :global(li)     { margin-bottom: 0.35rem; }
  .news-body :global(strong) { color: #14121a; font-weight: 600; }
  .news-body :global(a)      { color: #1a5bbf; text-decoration: underline; text-underline-offset: 3px; }
  .news-body :global(a:hover){ color: #134594; }
  .news-body :global(img)    { border-radius: 2px; margin: 1.5rem 0; }
</style>
